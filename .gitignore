__pycache__/
*.pyc

# tool caches. they each write a self-ignoring .gitignore, so this is belt-and-braces
# rather than load-bearing - but relying on a tool to ignore itself is not portable (P32)
.mypy_cache/
.ruff_cache/
.pytest_cache/

# compiled agent output, rebuilt by bin/render/b-compile.py
.generated/

# the venv a hand run of eval/plot_recall_scores.py may leave; its charts land
# under eval/results/, ignored below
.charts-venv/

# eval run trees: materialised fixtures, agent output and graded sheets. bulk,
# and specific to one run - the tasks and rubrics that generate them ARE tracked
eval/results/

# written by bin/render/b-graph.py
store/graph/graph.json

# scratch and open items, per machine, never committed
/plans/
