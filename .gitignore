__pycache__/
*.pyc

# tool caches. they each write a self-ignoring .gitignore, so this is belt-and-braces
# rather than load-bearing - but relying on a tool to ignore itself is not portable (P32)
.mypy_cache/
.ruff_cache/
.pytest_cache/

# compiled agent output, rebuilt by compile.py
.generated/

# rendered recall-quality charts and the venv that draws them (expected vs
# actual score per card, one per labelled prompt) - images are bulk, not
# versioned knowledge, and they are rebuilt by .charts/plot.py
.charts/*.png
.charts-venv/

# eval run trees: materialised fixtures, agent output and graded sheets. bulk,
# and specific to one run - the tasks and rubrics that generate them ARE tracked
eval/results/

# built on demand by brain-recall.py from the cards, so a committed copy could only drift
brain/graph/graph.json
