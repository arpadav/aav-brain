{
  "states": [
    {
      "id": "IDEATION",
      "kind": "entry",
      "owner": "-",
      "recall": false,
      "terminal": false,
      "entry": true,
      "regime": "ask-first",
      "binds": [],
      "doc": "raw request received (brain-plan entry)"
    },
    {
      "id": "INTENT",
      "kind": "work",
      "owner": "brain-meta-intent",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "position -> interest; surface ambiguity"
    },
    {
      "id": "ASK",
      "kind": "gate",
      "owner": "brain-meta-intent",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "ask the smallest unblocking question; never guess (pre-sanction clarify)"
    },
    {
      "id": "RECON",
      "kind": "work",
      "owner": "brain-recall+brain-plan",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "read fs; seed the relevant-file set from the task"
    },
    {
      "id": "EXPAND",
      "kind": "work",
      "owner": "brain-recall",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "grep deps/peripherals; ADD newly-implicated files. the set is mutable"
    },
    {
      "id": "WOULDIWRITE",
      "kind": "work",
      "owner": "brain-meta-style:plan",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "per file in the set: would i (arpad) write it like this? mark the no's"
    },
    {
      "id": "SCRUTINIZE",
      "kind": "work",
      "owner": "brain-meta-style:style",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "line-by-line on marked files: idiom, magic values, trim the fat"
    },
    {
      "id": "SEMANTIC",
      "kind": "work",
      "owner": "brain-meta-style:plan",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "does each fn/struct/class LIVE where it belongs? DRY, reuse, library-fy (P05/P31)"
    },
    {
      "id": "RELOCATE",
      "kind": "work",
      "owner": "worker+brain-review-gate",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "move fns/structs/classes to their correct module/file"
    },
    {
      "id": "HIERARCHY",
      "kind": "gate",
      "owner": "brain-meta-style:plan",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "judge the tree: flat->tree if a file too long / folder too flat-crowded; tree->flat if a refactor shrank it"
    },
    {
      "id": "REORG",
      "kind": "work",
      "owner": "worker+brain-review-gate",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "apply the reshape in the flagged direction; this MUTATES the set -> re-expand"
    },
    {
      "id": "PLAN",
      "kind": "work",
      "owner": "brain-plan",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "small+verbose plan with a worked example, to plans/"
    },
    {
      "id": "PLANPROBE",
      "kind": "work",
      "owner": "brain-plan",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "trace the plan THROUGH its own worked example; mark every step the plan cannot actually produce (plan-vs-impl gap)"
    },
    {
      "id": "PLANGATE",
      "kind": "gate",
      "owner": "brain-meta-style:plan",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "architectural scrutiny (brain-meta-style:plan AND the project-native reviewer when one exists - code-truth lens) + worked-example coherence; emits threshold_met only when plan_open==0 AND the worked example traces end-to-end. loops via below_threshold until then"
    },
    {
      "id": "SANCTION",
      "kind": "boundary",
      "owner": "brain-meta-drive",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "arpad approves; the regime flips to execute-through. LOG the plan's decided-against forks to the trace HERE (not deferred to CURATE - a sanctioned-but-unexecuted plan never reaches it)"
    },
    {
      "id": "DOCTRINE",
      "kind": "gate",
      "owner": "brain-meta-author-prompt",
      "recall": true,
      "terminal": false,
      "entry": true,
      "regime": "execute-through",
      "binds": [
        "code"
      ],
      "doc": "resolve the artifact PURPOSE (P41: scratch skip / tutorial light / production exhaustive) and the language row (P06); load the always-load doctrine set plus that language's extras; author the worker prompt carrying P40's before/after exemplars and the find-exhaustively ask. an adjective is not a resolved doctrine - emit unresolved (brain-execute entry, post-sanction)"
    },
    {
      "id": "IMPL",
      "kind": "work",
      "owner": "worker",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "execute-through",
      "binds": [],
      "doc": "dispatch the worker with the prompt DOCTRINE authored; implement the phase (post-sanction)"
    },
    {
      "id": "PHASEGATE",
      "kind": "gate",
      "owner": "brain-review-gate",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "cold unguided multi-lens review vs the repo; converge; emits threshold_met only when nits_open==0 AND consistent-with-repo. loops via below_threshold -> REMEDIATE"
    },
    {
      "id": "ADJUDICATE",
      "kind": "work",
      "owner": "brain-meta-style",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "a finding is EVIDENCE, not a verdict. classify each against the artifact's stated contract: valid | invalid | deferred-to-a-later-phase. ONLY valid findings reach REMEDIATE. an invalid one is REJECTED with a logged reason (brain-trace.py --reject), never fixed - fixing 'this is incomplete' on a deliberately-incomplete artifact is a loop that cannot terminate"
    },
    {
      "id": "REMEDIATE",
      "kind": "work",
      "owner": "brain-meta-author-prompt+worker",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "fix the ADJUDICATED-VALID nits IN PLACE (incl local relocations); does NOT leave the impl phase"
    },
    {
      "id": "VERIFY",
      "kind": "gate",
      "owner": "brain-verifier",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "build/test/bench honestly; emits sound only when the build is green AND the artifact's OWN stated bar is met AND the bench is within threshold. the bar is usually 'tests pass' but is NOT hardcoded to it: an artifact that ships deliberately red (a rustlings-style tutorial, a lab with todo!()) declares its real bar - e.g. `--features solutions` green while a bare `cargo test` stays red - and THAT is what soundness means for it. measuring against the wrong bar makes unsound permanent, the same non-terminating loop ADJUDICATE breaks at PHASEGATE. loops via unsound -> REMEDIATE. the pass events REQUIRE a returned brain-verifier report: measured, the agent was dispatched on 9 of ~31 visits, so 7 times in 10 the author verified its own work and advanced. verifying yourself is not verification - emit unverified and dispatch the agent"
    },
    {
      "id": "STYLE",
      "kind": "gate",
      "owner": "brain-meta-style:style + aav-style-separators + aav-style-docs + aav-style-imports + aav-style-items",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "the style gate, and it is ALWAYS required - only an explicit instruction against it skips it. resolve each language in the tree against the style-contract card, dispatch the aav-style lenses (separators, docs, imports, items) to apply it, then PROVE the result with brain-fmt.py --check. emits styled ONLY when the mechanical checks pass: local separators present inside function bodies, no blank line after any separator, global labels inside the closed whitelist, formatter clean. anything else emits unstyled and loops back. before this gate existed STYLE had a single outbound event, which made a hollow pass and a thorough one indistinguishable to the machine - it ran every time and landed nothing"
    },
    {
      "id": "RECORD",
      "kind": "work",
      "owner": "brain-meta-commit",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "categorise by semantics, draft the commit script, stop at the line"
    },
    {
      "id": "CURATE",
      "kind": "work",
      "owner": "brain-meta-curate",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "capture every correction/approval/interrupt -> update the store; log the decision trace"
    },
    {
      "id": "BLOCKED",
      "kind": "halt",
      "owner": "brain-meta-intent",
      "recall": false,
      "terminal": true,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "post-sanction ambiguity: stop and ask arpad; resume the blocked state on /continue"
    },
    {
      "id": "DONE",
      "kind": "terminal",
      "owner": "brain-learner",
      "recall": false,
      "terminal": true,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "work complete. DISPATCH brain-learner to mine this conversation for durable signal, and SAY SO in the closing line - e.g. `<brief summary>. everything is done. *note* i have dispatched an agent to learn from this conversation and refine the brain`. measured: IMPL was entered 176 times and CURATE 10, so a run that ends without this never taught the brain anything"
    },
    {
      "id": "REVIEW",
      "kind": "entry",
      "owner": "brain-review-gate",
      "recall": false,
      "terminal": false,
      "entry": true,
      "regime": "ask-first",
      "binds": [],
      "doc": "brain-review entry: cold unguided multi-lens review of the current diff; hand findings into the shared gate loop"
    },
    {
      "id": "SR_SCAN",
      "kind": "entry",
      "owner": "brain-self-refine",
      "recall": false,
      "terminal": false,
      "entry": true,
      "regime": "ask-first",
      "binds": [],
      "doc": "brain-self-refine entry: run the scripted scan (cards/graph/flow/trace/paths/symlinks/traceability)"
    },
    {
      "id": "SR_FINDINGS",
      "kind": "work",
      "owner": "brain-self-refine",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "read the trace + structural smells; GENERATE the questions from the brain (recall-driven, never a frozen list)"
    },
    {
      "id": "SR_ASK",
      "kind": "gate",
      "owner": "brain-self-refine",
      "recall": false,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "present FINDINGS + QUESTIONS only; he selects + annotates. consent is explicit - an unselected finding is dropped"
    },
    {
      "id": "SR_EDIT",
      "kind": "work",
      "owner": "brain-self-refine",
      "recall": true,
      "terminal": false,
      "entry": false,
      "regime": "",
      "binds": [],
      "doc": "make ONLY the selected edits, each through the right meta-skill (curate/style/direct)"
    }
  ],
  "transitions": [
    {
      "src": "ADJUDICATE",
      "dst": "VERIFY",
      "on": "all_invalid",
      "guard": "",
      "boundary": false
    },
    {
      "src": "ADJUDICATE",
      "dst": "VERIFY",
      "on": "deferred",
      "guard": "",
      "boundary": false
    },
    {
      "src": "ADJUDICATE",
      "dst": "REMEDIATE",
      "on": "valid_remain",
      "guard": "",
      "boundary": false
    },
    {
      "src": "ASK",
      "dst": "INTENT",
      "on": "answered",
      "guard": "",
      "boundary": false
    },
    {
      "src": "CURATE",
      "dst": "DONE",
      "on": "learned",
      "guard": "",
      "boundary": false
    },
    {
      "src": "DOCTRINE",
      "dst": "IMPL",
      "on": "resolved",
      "guard": "",
      "boundary": false
    },
    {
      "src": "DOCTRINE",
      "dst": "BLOCKED",
      "on": "unresolved",
      "guard": "",
      "boundary": false
    },
    {
      "src": "EXPAND",
      "dst": "EXPAND",
      "on": "set_grew",
      "guard": "",
      "boundary": false
    },
    {
      "src": "EXPAND",
      "dst": "WOULDIWRITE",
      "on": "set_stable",
      "guard": "",
      "boundary": false
    },
    {
      "src": "HIERARCHY",
      "dst": "REORG",
      "on": "reshape_needed",
      "guard": "",
      "boundary": false
    },
    {
      "src": "HIERARCHY",
      "dst": "PLAN",
      "on": "shape_ok",
      "guard": "",
      "boundary": false
    },
    {
      "src": "IDEATION",
      "dst": "INTENT",
      "on": "received",
      "guard": "",
      "boundary": false
    },
    {
      "src": "IMPL",
      "dst": "BLOCKED",
      "on": "ambiguous",
      "guard": "",
      "boundary": false
    },
    {
      "src": "IMPL",
      "dst": "PHASEGATE",
      "on": "implemented",
      "guard": "",
      "boundary": false
    },
    {
      "src": "IMPL",
      "dst": "DOCTRINE",
      "on": "phase_done",
      "guard": "",
      "boundary": false
    },
    {
      "src": "INTENT",
      "dst": "ASK",
      "on": "ambiguous",
      "guard": "",
      "boundary": false
    },
    {
      "src": "INTENT",
      "dst": "RECON",
      "on": "clear",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PHASEGATE",
      "dst": "ADJUDICATE",
      "on": "below_threshold",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PHASEGATE",
      "dst": "VERIFY",
      "on": "threshold_met",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PLAN",
      "dst": "PLANPROBE",
      "on": "drafted",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PLANGATE",
      "dst": "PLAN",
      "on": "below_threshold",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PLANGATE",
      "dst": "ASK",
      "on": "blocked",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PLANGATE",
      "dst": "SANCTION",
      "on": "threshold_met",
      "guard": "",
      "boundary": true
    },
    {
      "src": "PLANPROBE",
      "dst": "PLAN",
      "on": "gap_found",
      "guard": "",
      "boundary": false
    },
    {
      "src": "PLANPROBE",
      "dst": "PLANGATE",
      "on": "traced",
      "guard": "",
      "boundary": false
    },
    {
      "src": "RECON",
      "dst": "EXPAND",
      "on": "seeded",
      "guard": "",
      "boundary": false
    },
    {
      "src": "RECORD",
      "dst": "CURATE",
      "on": "prepared",
      "guard": "",
      "boundary": false
    },
    {
      "src": "RELOCATE",
      "dst": "EXPAND",
      "on": "moved",
      "guard": "",
      "boundary": false
    },
    {
      "src": "REMEDIATE",
      "dst": "PHASEGATE",
      "on": "fixed",
      "guard": "",
      "boundary": false
    },
    {
      "src": "REORG",
      "dst": "EXPAND",
      "on": "reshaped",
      "guard": "",
      "boundary": false
    },
    {
      "src": "REVIEW",
      "dst": "PHASEGATE",
      "on": "reviewed",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SANCTION",
      "dst": "DOCTRINE",
      "on": "sanctioned",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SCRUTINIZE",
      "dst": "SEMANTIC",
      "on": "cleaned",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SEMANTIC",
      "dst": "RELOCATE",
      "on": "misplacements_found",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SEMANTIC",
      "dst": "HIERARCHY",
      "on": "placement_ok",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SR_ASK",
      "dst": "DONE",
      "on": "none_selected",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SR_ASK",
      "dst": "SR_EDIT",
      "on": "selected",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SR_EDIT",
      "dst": "VERIFY",
      "on": "edited",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SR_FINDINGS",
      "dst": "SR_ASK",
      "on": "found",
      "guard": "",
      "boundary": false
    },
    {
      "src": "SR_SCAN",
      "dst": "SR_FINDINGS",
      "on": "scanned",
      "guard": "",
      "boundary": false
    },
    {
      "src": "STYLE",
      "dst": "RECORD",
      "on": "styled",
      "guard": "",
      "boundary": false
    },
    {
      "src": "STYLE",
      "dst": "STYLE",
      "on": "unstyled",
      "guard": "",
      "boundary": false
    },
    {
      "src": "VERIFY",
      "dst": "STYLE",
      "on": "last_phase",
      "guard": "",
      "boundary": false
    },
    {
      "src": "VERIFY",
      "dst": "DOCTRINE",
      "on": "more_phases",
      "guard": "!self_refine",
      "boundary": false
    },
    {
      "src": "VERIFY",
      "dst": "REMEDIATE",
      "on": "unsound",
      "guard": "",
      "boundary": false
    },
    {
      "src": "VERIFY",
      "dst": "VERIFY",
      "on": "unverified",
      "guard": "",
      "boundary": false
    },
    {
      "src": "WOULDIWRITE",
      "dst": "SEMANTIC",
      "on": "all_pass",
      "guard": "",
      "boundary": false
    },
    {
      "src": "WOULDIWRITE",
      "dst": "SCRUTINIZE",
      "on": "some_marked",
      "guard": "",
      "boundary": false
    }
  ],
  "boundary": "SANCTION",
  "warnings": []
}
